# Copie este arquivo para ".env" e preencha com valores reais.
# O .env nunca é commitado (ver .gitignore).

# --- Wake ------------------------------------------------------------------
WAKE_API_BASE_URL=
WAKE_AUTH_HEADER_NAME=
WAKE_API_TOKEN=
WAKE_CUSTOMERS_ENDPOINT=

# --- Octadesk ----------------------------------------------------------------
OCTADESK_API_BASE_URL=
OCTADESK_API_KEY=
